---
// Link (P1.DS.11): a text link with an animated underline. External links are detected from the
// href (another host than site.url): they get an arrow icon, `rel="noopener noreferrer"`,
// `data-cursor="open"` (P1.FX.17) and open in a new tab with a spoken hint. Styles live in
// src/styles/link.css so Svelte islands can share them. The arrow is the `arrow-up-right` Icon
// (P1.DS.13); link.css sizes it to the label.
import type { HTMLAttributes } from 'astro/types';

import { site } from '@/data/site';

import Icon from './Icon.astro';
import { classifyHref, linkClasses, mergeRel, type LinkVariant } from './link';
import '@/styles/link.css';

interface Props extends Omit<HTMLAttributes<'a'>, 'href' | 'target'> {
  href: string;
  /** `inline`: accent color, underline always visible (for running text). `quiet`: inherits
   *  the text color, the underline only draws in on hover and focus (nav, footer, meta rows). */
  variant?: LinkVariant;
  /** Overrides the detection from href, e.g. for a same-host file the site does not render. */
  external?: boolean;
  /** Defaults to true for external links. A new tab always gets the spoken hint. */
  newTab?: boolean;
  /** Spoken after the label when the link opens a new tab. */
  newTabLabel?: string;
}

const {
  href,
  variant = 'inline',
  external: externalOverride,
  newTab: newTabOverride,
  newTabLabel = '(opens in a new tab)',
  class: className,
  rel,
  ...rest
} = Astro.props;

const kind = classifyHref(href, site.url);
const external = externalOverride ?? kind === 'external';
const newTab = newTabOverride ?? external;

// A label written over several lines (as Prettier formats long children) keeps a leading and
// trailing space, which the underline would draw under. The slot is rendered and trimmed first;
// set:html only re-inserts what <slot /> would have rendered: Astro has already escaped every
// expression in it, so no unescaped input reaches the page (AGENTS.md §6.2).
const label = (await Astro.slots.render('default')).trim();
---

<a
  data-cursor={external ? 'open' : undefined}
  {...rest}
  href={href}
  target={newTab ? '_blank' : undefined}
  rel={mergeRel(rel ?? undefined, { external, newTab })}
  class:list={[...linkClasses(variant), className]}
>
  {/* eslint-disable-next-line astro/no-set-html-directive -- trimmed slot output, see above */}
  <span class="link__label" set:html={label} />
  {external && <Icon name="arrow-up-right" class="link__icon" />}
  {newTab && <span class="link__hint"> {newTabLabel}</span>}
</a>

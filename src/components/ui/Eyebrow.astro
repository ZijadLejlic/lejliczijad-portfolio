---
/* eslint-disable astro/no-unused-css-selector -- the root is a dynamic <Tag>, whose classes the rule cannot see; tests/unit/components covers them. */
// Mono label above a heading or in a corner (P1.DS.09): "Selected work", "CET 14:05".
// Write it in sentence case; CSS uppercases it, so screen readers do not spell it out.
import type { HTMLAttributes } from 'astro/types';

type EyebrowTag = 'p' | 'span' | 'div';
type EyebrowTone = 'muted' | 'accent';

interface Props extends HTMLAttributes<'p'> {
  as?: EyebrowTag;
  tone?: EyebrowTone;
}

const { as: Tag = 'p', tone = 'muted', class: className, ...rest } = Astro.props;
---

<Tag class:list={['eyebrow', `eyebrow--${tone}`, className]} {...rest}>
  <slot />
</Tag>

<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    font-weight: var(--weight-medium);
    line-height: var(--leading-mono);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
  }

  /* 7.95:1 on bg; subtle is not used, because labels may sit above the FX canvas. */
  .eyebrow--muted {
    color: var(--color-text-muted);
  }

  .eyebrow--accent {
    color: var(--color-accent);
  }
</style>

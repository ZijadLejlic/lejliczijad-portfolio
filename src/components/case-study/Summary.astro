---
// Summary card at the top of a full case study (prd.md §7.3, section 2): client, industry,
// services, timeline, stack, role, live link and the key result. A description list, so screen
// readers pair each label with its value.
import { linkHost } from './case-study';

interface Props {
  client: string;
  industry: string;
  /** Service names as shown to visitors, e.g. "Web app development". */
  services: string[];
  timeline: string;
  stack: string[];
  role: string;
  /** One sentence; the number in it needs a source like any metric (AGENTS.md §7). */
  result: string;
  liveUrl?: string;
}

const { client, industry, services, timeline, stack, role, result, liveUrl } = Astro.props;
const host = liveUrl ? linkHost(liveUrl) : undefined;
// Explicit, because Safari drops list semantics with list-style: none (src/styles/reset.css).
const LIST_ROLE = 'list';
---

<section class="summary" aria-label="Project summary">
  <dl class="summary__list">
    <div class="summary__item">
      <dt>Client</dt>
      <dd>{client}</dd>
    </div>
    <div class="summary__item">
      <dt>Industry</dt>
      <dd>{industry}</dd>
    </div>
    <div class="summary__item">
      <dt>Services</dt>
      <dd>
        <ul role={LIST_ROLE} class="summary__inline">
          {services.map((service) => (
            <li>{service}</li>
          ))}
        </ul>
      </dd>
    </div>
    <div class="summary__item">
      <dt>Timeline</dt>
      <dd>{timeline}</dd>
    </div>
    <div class="summary__item">
      <dt>Stack</dt>
      <dd>
        <ul role={LIST_ROLE} class="summary__inline">
          {stack.map((tech) => (
            <li>{tech}</li>
          ))}
        </ul>
      </dd>
    </div>
    <div class="summary__item">
      <dt>Role</dt>
      <dd>{role}</dd>
    </div>
    {liveUrl && (
      <div class="summary__item">
        <dt>Live</dt>
        <dd>
          <a href={liveUrl} rel="noopener noreferrer" data-cursor="open">
            {host}
          </a>
        </dd>
      </div>
    )}
    <div class="summary__item summary__item--result">
      <dt>Result</dt>
      <dd>{result}</dd>
    </div>
  </dl>
</section>

<style>
  .summary {
    padding: var(--space-5);
    background-color: var(--color-surface-1);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .summary__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr));
    gap: var(--space-5);
  }

  .summary__item {
    min-width: 0;
  }

  .summary__item--result {
    grid-column: 1 / -1;
    padding-block-start: var(--space-5);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  dt {
    margin-block-end: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    line-height: var(--leading-mono);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
  }

  dd {
    overflow-wrap: anywhere;
  }

  .summary__item--result dd {
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
  }

  .summary__inline {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-1);
    padding: 0;
  }

  /* Comma separators are visual only; the list semantics already separate the items. */
  .summary__inline li:not(:last-child)::after {
    content: ',';
  }
</style>

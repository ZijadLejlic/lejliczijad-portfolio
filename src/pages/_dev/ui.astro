---
// Component gallery (P1.DS.08–12, completed by P1.DS.26). Served at /_dev/ui by `astro dev` and in
// preview builds only; the route is injected in astro.config.ts and never exists in production
// (src/lib/dev-pages.ts). Global styles are imported here until BaseLayout exists (P1.LAY.01).
import AvailabilityBadge from '@/components/ui/AvailabilityBadge.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Cluster from '@/components/ui/Cluster.astro';
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Grid from '@/components/ui/Grid.astro';
import Heading from '@/components/ui/Heading.astro';
import Link from '@/components/ui/Link.astro';
import Prose from '@/components/ui/Prose.astro';
import Section from '@/components/ui/Section.astro';
import Stack from '@/components/ui/Stack.astro';
import Tag from '@/components/ui/Tag.astro';
import Text from '@/components/ui/Text.astro';
import FontPreload from '@/components/layout/FontPreload.astro';
import '@/styles/tokens.css';
import '@/styles/fonts.css';
import '@/styles/reset.css';
import '@/styles/base.css';
import '@/styles/motion.css';

interface PropRow {
  name: string;
  values: string;
  fallback: string;
}

interface GalleryEntry {
  id: string;
  name: string;
  purpose: string;
  props: PropRow[];
}

const GAP_VALUES = '1–11 (--space-N)';

const COMPONENTS: GalleryEntry[] = [
  {
    id: 'container',
    name: 'Container',
    purpose:
      'Centers content, caps it at --container-max (1440 px at the default font size) and adds the fluid gutter.',
    props: [
      {
        name: 'as',
        values: 'div, section, article, aside, header, footer, main, nav, ul, ol',
        fallback: 'div',
      },
      { name: 'width', values: 'default, prose', fallback: 'default' },
    ],
  },
  {
    id: 'section',
    name: 'Section',
    purpose:
      'Vertical page rhythm (--section-padding-block) with a Container inside. Name it with aria-labelledby.',
    props: [
      { name: 'as', values: 'section, div, article, aside, footer', fallback: 'section' },
      { name: 'spacing', values: 'default, compact, none', fallback: 'default' },
      { name: 'contained', values: 'true, false', fallback: 'true' },
      { name: 'width', values: 'default, prose', fallback: 'default' },
    ],
  },
  {
    id: 'grid',
    name: 'Grid',
    purpose:
      'As many equal columns as fit, each at least min wide. Below that width it falls back to one full-width column.',
    props: [
      { name: 'as', values: 'div, ul, ol, …', fallback: 'div' },
      { name: 'min', values: 'sm (14rem), md (18rem), lg (24rem)', fallback: 'md' },
      { name: 'gap', values: GAP_VALUES, fallback: '5' },
    ],
  },
  {
    id: 'stack',
    name: 'Stack',
    purpose: 'Vertical flow with one gap between children, so children never carry margins.',
    props: [
      { name: 'as', values: 'div, ul, ol, …', fallback: 'div' },
      { name: 'gap', values: GAP_VALUES, fallback: '5' },
      { name: 'align', values: 'stretch, start, center, end', fallback: 'stretch' },
    ],
  },
  {
    id: 'cluster',
    name: 'Cluster',
    purpose: 'Inline group that wraps onto new lines: tags, buttons, meta rows.',
    props: [
      { name: 'as', values: 'div, ul, ol, …', fallback: 'div' },
      { name: 'gap', values: GAP_VALUES, fallback: '3' },
      { name: 'justify', values: 'start, center, end, between', fallback: 'start' },
      { name: 'align', values: 'center, start, end, baseline, stretch', fallback: 'center' },
    ],
  },
  {
    id: 'heading',
    name: 'Heading',
    purpose:
      'level sets the outline (one h1 per page, no skipped levels); size only changes the look.',
    props: [
      { name: 'level', values: '1–6 (required)', fallback: '–' },
      { name: 'size', values: 'display, h1, h2, h3, body', fallback: 'matches level (4–6 → body)' },
    ],
  },
  {
    id: 'eyebrow',
    name: 'Eyebrow',
    purpose:
      'Mono label above a heading or in a corner. Write it in sentence case; CSS uppercases it.',
    props: [
      { name: 'as', values: 'p, span, div', fallback: 'p' },
      { name: 'tone', values: 'muted, accent', fallback: 'muted' },
    ],
  },
  {
    id: 'text',
    name: 'Text',
    purpose:
      'Running text outside Prose. tone="subtle" never goes on surface-2 or above the FX canvas.',
    props: [
      { name: 'as', values: 'p, span, div', fallback: 'p' },
      { name: 'size', values: 'lead, body, small', fallback: 'body' },
      { name: 'tone', values: 'default, muted, subtle', fallback: 'default' },
      { name: 'measure', values: 'true, false (cap at 68ch)', fallback: 'false' },
    ],
  },
  {
    id: 'prose',
    name: 'Prose',
    purpose:
      'Wrapper for MDX and long-form text: block rhythm, lists, quotes, code and tables, capped at 68ch.',
    props: [{ name: 'as', values: 'div, article, section', fallback: 'div' }],
  },
  {
    id: 'button',
    name: 'Button',
    purpose:
      'A <button>, or an <a> when href is set. Icons go in the icon-start / icon-end slots. Loading keeps focus but ignores clicks; disabled leaves the tab order.',
    props: [
      { name: 'variant', values: 'primary, secondary, ghost', fallback: 'primary' },
      { name: 'size', values: 'sm (40 px), md (48 px), lg (56 px)', fallback: 'md' },
      { name: 'href', values: 'URL (renders an <a>)', fallback: '–' },
      { name: 'type', values: 'button, submit, reset', fallback: 'button' },
      { name: 'block', values: 'true, false (full width)', fallback: 'false' },
      { name: 'disabled', values: 'true, false', fallback: 'false' },
      { name: 'loading', values: 'true, false', fallback: 'false' },
      { name: 'loadingLabel', values: 'text spoken while loading', fallback: 'Loading' },
    ],
  },
  {
    id: 'link',
    name: 'Link',
    purpose:
      'Text link with an underline that draws in on hover and focus. Another host than site.url is detected as external: arrow icon, rel="noopener noreferrer", new tab with a spoken hint, open cursor. Unsafe schemes (javascript:, data:) fail the build.',
    props: [
      { name: 'href', values: 'URL (required)', fallback: '–' },
      {
        name: 'variant',
        values: 'inline (accent, resting underline), quiet (inherits color)',
        fallback: 'inline',
      },
      {
        name: 'external',
        values: 'true, false (overrides detection)',
        fallback: 'detected from href',
      },
      { name: 'newTab', values: 'true, false', fallback: 'true for external' },
      {
        name: 'newTabLabel',
        values: 'text spoken for a new tab',
        fallback: '(opens in a new tab)',
      },
    ],
  },
  {
    id: 'tag',
    name: 'Tag',
    purpose:
      'Non-interactive label for a stack item or topic. Several tags go in <Cluster as="ul"> with as="li". Filters are buttons, not tags.',
    props: [
      { name: 'as', values: 'span, li', fallback: 'span' },
      { name: 'tone', values: 'default, accent', fallback: 'default' },
    ],
  },
  {
    id: 'badge',
    name: 'Badge',
    purpose:
      'Status pill. The text carries the meaning; the dot repeats it in color and is aria-hidden. The pulse stops under reduced motion.',
    props: [
      { name: 'as', values: 'span, p, div', fallback: 'span' },
      { name: 'tone', values: 'neutral, accent, success (dot color)', fallback: 'neutral' },
      { name: 'dot', values: 'true, false', fallback: 'true' },
      { name: 'pulse', values: 'true, false', fallback: 'false' },
    ],
  },
  {
    id: 'availability-badge',
    name: 'AvailabilityBadge',
    purpose:
      'Badge that reads site.availability (src/data/site.ts) and builds its text with availabilityLabel(). Pages pass no props.',
    props: [
      { name: 'as', values: 'span, p, div', fallback: 'span' },
      { name: 'availability', values: 'previews and tests only', fallback: 'site.availability' },
    ],
  },
];

const CARDS = ['One', 'Two', 'Three', 'Four', 'Five'];
const CHIPS = ['Astro', 'TypeScript', 'three.js', 'Cloudflare Workers', 'Svelte', 'PostgreSQL'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>UI components — dev</title>
    <FontPreload />
  </head>
  <body>
    <main>
      <Section spacing="compact" aria-labelledby="ui-title">
        <Stack gap={4}>
          <Eyebrow>/_dev/ui · not in production</Eyebrow>
          <Heading level={1} id="ui-title">
            UI components
          </Heading>
          <Text size="lead" tone="muted" measure>
            Every design-system component with its props. Shrink the window to check that nothing
            overflows.
          </Text>
          <nav aria-label="Components">
            <Cluster as="ul" gap={4}>
              {COMPONENTS.map((primitive) => (
                <li>
                  <a href={`#${primitive.id}`}>{primitive.name}</a>
                </li>
              ))}
            </Cluster>
          </nav>
        </Stack>
      </Section>

      {COMPONENTS.map((primitive) => (
        <Section id={primitive.id} spacing="compact" aria-labelledby={`${primitive.id}-title`}>
          <Stack gap={6}>
            <Stack gap={3}>
              <Heading level={2} id={`${primitive.id}-title`}>
                {primitive.name}
              </Heading>
              <Text tone="muted" measure>
                {primitive.purpose}
              </Text>
            </Stack>

            <div class="props">
              <table>
                <caption class="visually-hidden">{primitive.name} props</caption>
                <thead>
                  <tr>
                    <th scope="col">Prop</th>
                    <th scope="col">Values</th>
                    <th scope="col">Default</th>
                  </tr>
                </thead>
                <tbody>
                  {primitive.props.map((row) => (
                    <tr>
                      <th scope="row">
                        <code>{row.name}</code>
                      </th>
                      <td>{row.values}</td>
                      <td>
                        <code>{row.fallback}</code>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div class="demo" data-demo={primitive.id}>
              {primitive.id === 'container' && (
                <Stack gap={4}>
                  <Container class="outline">
                    <p class="box">Container (default)</p>
                  </Container>
                  <Container width="prose" class="outline">
                    <p class="box">Container width="prose"</p>
                  </Container>
                </Stack>
              )}

              {primitive.id === 'section' && (
                <Stack gap={4}>
                  <Section as="div" spacing="compact" class="outline">
                    <p class="box">Section spacing="compact"</p>
                  </Section>
                  <Section as="div" spacing="none" contained={false} class="outline">
                    <p class="box">Section spacing="none" contained=false</p>
                  </Section>
                </Stack>
              )}

              {primitive.id === 'grid' && (
                <Stack gap={5}>
                  {(['sm', 'md', 'lg'] as const).map((min) => (
                    <Stack gap={2}>
                      <Eyebrow>min="{min}"</Eyebrow>
                      <Grid as="ul" min={min} gap={4}>
                        {CARDS.map((card) => (
                          <li class="box">{card}</li>
                        ))}
                      </Grid>
                    </Stack>
                  ))}
                </Stack>
              )}

              {primitive.id === 'stack' && (
                <Grid min="sm" gap={5}>
                  {([2, 5, 7] as const).map((gap) => (
                    <Stack gap={2}>
                      <Eyebrow>gap={gap}</Eyebrow>
                      <Stack gap={gap}>
                        <p class="box">First</p>
                        <p class="box">Second</p>
                        <p class="box">Third</p>
                      </Stack>
                    </Stack>
                  ))}
                  <Stack gap={2}>
                    <Eyebrow>align="start"</Eyebrow>
                    <Stack gap={3} align="start">
                      <p class="box">Short</p>
                      <p class="box">A longer item</p>
                    </Stack>
                  </Stack>
                </Grid>
              )}

              {primitive.id === 'cluster' && (
                <Stack gap={5}>
                  {(['start', 'center', 'between'] as const).map((justify) => (
                    <Stack gap={2}>
                      <Eyebrow>justify="{justify}"</Eyebrow>
                      <Cluster as="ul" justify={justify} gap={2}>
                        {CHIPS.map((chip) => (
                          <li class="chip">{chip}</li>
                        ))}
                      </Cluster>
                    </Stack>
                  ))}
                </Stack>
              )}

              {primitive.id === 'heading' && (
                <Stack gap={5}>
                  <Heading level={3} size="display">
                    Display
                  </Heading>
                  <Heading level={3} size="h1">
                    Heading h1 size
                  </Heading>
                  <Heading level={3} size="h2">
                    Heading h2 size
                  </Heading>
                  <Heading level={3}>Heading h3 size</Heading>
                  <Heading level={4}>Heading level 4 (body size)</Heading>
                  <Text size="small" tone="muted">
                    All demo headings are level 3–4, so this page keeps a single h1.
                  </Text>
                </Stack>
              )}

              {primitive.id === 'eyebrow' && (
                <Stack gap={4}>
                  <Eyebrow>Selected work</Eyebrow>
                  <Eyebrow tone="accent">Available for new projects</Eyebrow>
                  <Cluster gap={2}>
                    <Eyebrow as="span">Full-stack developer</Eyebrow>
                    <Eyebrow as="span">·</Eyebrow>
                    <Eyebrow as="span">CET 14:05</Eyebrow>
                  </Cluster>
                </Stack>
              )}

              {primitive.id === 'text' && (
                <Stack gap={5}>
                  {(['lead', 'body', 'small'] as const).map((size) => (
                    <Stack gap={2}>
                      <Eyebrow>size="{size}"</Eyebrow>
                      <Text size={size} measure>
                        I build web apps and websites for small and mid-sized businesses, from the
                        first call to launch and support.
                      </Text>
                    </Stack>
                  ))}
                  <Stack gap={2}>
                    <Eyebrow>tone</Eyebrow>
                    <Text>Default text color.</Text>
                    <Text tone="muted">Muted text color.</Text>
                    <Text tone="subtle">Subtle text color (page background only).</Text>
                  </Stack>
                </Stack>
              )}

              {primitive.id === 'link' && (
                <Stack gap={6}>
                  <Stack gap={2}>
                    <Eyebrow>variant="inline" · in running text</Eyebrow>
                    <Text measure>
                      Read the <Link href="#link">internal case study</Link>, check the code on{' '}
                      <Link href="https://github.com/ZijadLejlic">GitHub</Link>, or write to{' '}
                      <Link href="mailto:support@lejliczijad.com">support@lejliczijad.com</Link>.
                    </Text>
                    <Text measure>
                      <Link href="https://developer.mozilla.org/en-US/docs/Web/CSS/box-decoration-break">
                        MDN on box-decoration-break and how it clones decorations across lines
                      </Link>{' '}
                      is a long external label: it wraps and keeps its underline on every line
                    </Text>
                  </Stack>
                  <Stack gap={2}>
                    <Eyebrow>variant="quiet" · nav and footer</Eyebrow>
                    <Cluster gap={5} as="ul">
                      <li>
                        <Link href="#link" variant="quiet">
                          Work
                        </Link>
                      </li>
                      <li>
                        <Link href="#link" variant="quiet">
                          About
                        </Link>
                      </li>
                      <li>
                        <Link href="https://github.com/ZijadLejlic" variant="quiet">
                          GitHub
                        </Link>
                      </li>
                    </Cluster>
                  </Stack>
                  <Stack gap={2}>
                    <Eyebrow>External, same tab · absolute URL on this site</Eyebrow>
                    <Text>
                      <Link href="https://example.com" newTab={false}>
                        Same-tab external
                      </Link>{' '}
                      ·{' '}
                      <Link href="https://lejliczijad.com/work">
                        lejliczijad.com/work (internal)
                      </Link>
                    </Text>
                  </Stack>
                </Stack>
              )}

              {primitive.id === 'button' && (
                <Stack gap={6}>
                  {(['primary', 'secondary', 'ghost'] as const).map((variant) => (
                    <Stack gap={2}>
                      <Eyebrow>variant="{variant}"</Eyebrow>
                      <Cluster gap={3}>
                        <Button variant={variant} size="sm">
                          Small
                        </Button>
                        <Button variant={variant}>Medium</Button>
                        <Button variant={variant} size="lg">
                          Large
                        </Button>
                      </Cluster>
                    </Stack>
                  ))}

                  <Stack gap={2}>
                    <Eyebrow>With icons · as links</Eyebrow>
                    <Cluster gap={3}>
                      <Button href="#button">
                        Book a call
                        <svg slot="icon-end" viewBox="0 0 16 16" fill="none" stroke="currentColor">
                          <path d="M3 8h10M9 4l4 4-4 4" stroke-width="1.5" />
                        </svg>
                      </Button>
                      <Button variant="secondary" href="#button-form">
                        <svg slot="icon-start" viewBox="0 0 16 16" fill="currentColor">
                          <path d="M4 2.5v11l9-5.5z" />
                        </svg>
                        Meet me
                      </Button>
                      <Button variant="ghost" href="https://example.com" target="_blank">
                        Opens in a new tab
                      </Button>
                    </Cluster>
                  </Stack>

                  <Stack gap={2}>
                    <Eyebrow>Disabled · loading</Eyebrow>
                    <Cluster gap={3}>
                      <Button disabled>Disabled button</Button>
                      <Button variant="secondary" href="#button" disabled>
                        Disabled link
                      </Button>
                      <Button loading loadingLabel="Sending">
                        Send message
                      </Button>
                      <Button variant="secondary" loading>
                        Loading
                      </Button>
                    </Cluster>
                  </Stack>

                  <Stack gap={2}>
                    <Eyebrow>Busy submit button blocks the form</Eyebrow>
                    <form action="/_dev/ui" method="get" id="button-form">
                      <Stack gap={3} align="start">
                        <label for="button-form-name">Name</label>
                        <input id="button-form-name" name="name" type="text" class="demo-input" />
                        <Button type="submit" loading loadingLabel="Sending">
                          Submit form
                        </Button>
                      </Stack>
                    </form>
                  </Stack>

                  <Stack gap={2}>
                    <Eyebrow>block · long label</Eyebrow>
                    <Button block>Full-width button</Button>
                    <Button variant="secondary">
                      A deliberately long button label that has to wrap on a narrow phone screen
                    </Button>
                  </Stack>
                </Stack>
              )}

              {primitive.id === 'tag' && (
                <Stack gap={4}>
                  <Stack gap={2}>
                    <Eyebrow>Stack list · tone="default"</Eyebrow>
                    <Cluster as="ul" gap={2} aria-label="Stack">
                      {CHIPS.map((chip) => (
                        <Tag as="li">{chip}</Tag>
                      ))}
                    </Cluster>
                  </Stack>
                  <Stack gap={2}>
                    <Eyebrow>tone="accent" · long label</Eyebrow>
                    <Cluster gap={2}>
                      <Tag tone="accent">Full case study</Tag>
                      <Tag>A deliberately long tag label that has to wrap on a narrow phone</Tag>
                    </Cluster>
                  </Stack>
                </Stack>
              )}

              {primitive.id === 'badge' && (
                <Stack gap={2}>
                  <Eyebrow>tone · dot · pulse</Eyebrow>
                  <Cluster gap={3}>
                    <Badge>Neutral</Badge>
                    <Badge tone="accent">Accent</Badge>
                    <Badge tone="success">Success</Badge>
                    <Badge tone="success" pulse>
                      Success, pulsing
                    </Badge>
                    <Badge dot={false}>No dot</Badge>
                  </Cluster>
                </Stack>
              )}

              {primitive.id === 'availability-badge' && (
                <Stack gap={4}>
                  <Stack gap={2}>
                    <Eyebrow>From site.ts (what pages render)</Eyebrow>
                    <div>
                      <AvailabilityBadge />
                    </div>
                  </Stack>
                  <Stack gap={2}>
                    <Eyebrow>Every status (preview values, not real availability)</Eyebrow>
                    <Cluster gap={3}>
                      <AvailabilityBadge availability={{ status: 'available', from: '2027-01' }} />
                      <AvailabilityBadge availability={{ status: 'limited' }} />
                      <AvailabilityBadge availability={{ status: 'booked', from: '2027-03' }} />
                    </Cluster>
                  </Stack>
                </Stack>
              )}

              {primitive.id === 'prose' && (
                <Prose>
                  <h2 id="prose-sample">The challenge</h2>
                  <p>
                    Staff tracked appointments in a shared spreadsheet. Two people could book the
                    same slot, and nobody knew until the patient arrived. This sample shows{' '}
                    <strong>strong text</strong>, <a href="#prose">a link</a> and{' '}
                    <code>inline code</code>.
                  </p>
                  <h3>What changed</h3>
                  <ul>
                    <li>One calendar for every doctor and room</li>
                    <li>
                      Reminders by email
                      <ul>
                        <li>A nested list item</li>
                      </ul>
                    </li>
                    <li>
                      A very long item with a URL
                      https://example.com/a/very/long/path/that/should/wrap
                    </li>
                  </ul>
                  <ol>
                    <li>Discovery call</li>
                    <li>Proposal and estimate</li>
                    <li>Weekly demos</li>
                  </ol>
                  <blockquote>
                    <p>A sample quote, to show the blockquote style.</p>
                  </blockquote>
                  <pre><code>{`const slots = await getFreeSlots({ doctorId, day });\nif (slots.length === 0) notifyWaitlist(doctorId);`}</code></pre>
                  <table>
                    <thead>
                      <tr>
                        <th scope="col">Role</th>
                        <th scope="col">Uses it for</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <td>Reception</td>
                        <td>Booking and check-in</td>
                      </tr>
                      <tr>
                        <td>Doctor</td>
                        <td>Daily schedule</td>
                      </tr>
                    </tbody>
                  </table>
                  <hr />
                  <p>Text after a divider.</p>
                </Prose>
              )}
            </div>
          </Stack>
        </Section>
      ))}
    </main>
  </body>
</html>

<style>
  /* Demo-only styling for the gallery itself. */
  .props {
    max-width: 100%;
    overflow-x: auto;
  }

  table {
    width: 100%;
    font-size: var(--text-small);
    line-height: var(--leading-small);
    border-collapse: collapse;
  }

  th,
  td {
    padding: var(--space-2) var(--space-3);
    vertical-align: top;
    text-align: start;
    border-block-end: var(--border-width) solid var(--color-border-strong);
  }

  thead th {
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.95em;
  }

  .demo {
    padding: var(--space-5);
    border: var(--border-width) dashed var(--color-border-strong);
    border-radius: var(--radius-md);
  }

  .box {
    padding: var(--space-4);
    font-size: var(--text-small);
    background-color: var(--color-surface-2);
    border-radius: var(--radius-sm);
  }

  .chip {
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-small);
    background-color: var(--color-surface-2);
    border-radius: var(--radius-pill);
  }

  /* :global because Container and Section render their own root element. */
  .demo :global(.outline) {
    outline: var(--border-width) solid var(--color-accent);
    outline-offset: calc(-1 * var(--border-width));
  }

  .demo-input {
    min-block-size: var(--control-height-md);
    padding-inline: var(--space-3);
    color: var(--color-text);
    background-color: var(--color-surface-2);
    border: var(--border-width) solid var(--color-text-subtle);
    border-radius: var(--radius-sm);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    white-space: nowrap;
    clip-path: inset(50%);
  }
</style>

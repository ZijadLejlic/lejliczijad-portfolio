---
// Renderer, loop and adaptive quality harness (P1.FX.05, P1.FX.06, P1.FX.07). Served at /_dev/fx by `astro dev` and in preview
// builds only (src/lib/dev-pages.ts). It drives the real renderer and render loop on a full-screen
// canvas, simulates context loss through WEBGL_lose_context and can hide the canvas, so recovery and
// the loop's pauses can be checked by hand and by tests/e2e/fx-renderer.spec.ts and fx-loop.spec.ts. It ignores reduced motion and the capability check on purpose:
// the tier comes from `?fx=high|medium|low` (forced, adaptation off, as on the site) or starts at
// high with adaptive quality on, so any browser with WebGL2 can test it. `?work=<ms>` adds that
// much CPU work per frame (calibrated at load), a stand-in for the simulation's cost: fine at full speed, too slow under a
// 6× CPU throttle (tests/e2e/fx-quality.spec.ts).
// `?scene=vortex` replaces the triangle with the vortex simulation (P1.FX.08) at the tier's particle
// count; adaptive tier changes rebuild it, and `?fx=off|static` there starts nothing (as on the
// site). `?panel=off` hides the status panel for screenshots and video. The vortex scene makes the
// page tall, so scrolling drives the scroll reaction (P1.FX.11, tests/e2e/fx-scroll.spec.ts).
import Container from '@/components/ui/Container.astro';
import Heading from '@/components/ui/Heading.astro';
import Stack from '@/components/ui/Stack.astro';
import Text from '@/components/ui/Text.astro';
import FontPreload from '@/components/layout/FontPreload.astro';
import '@/styles/tokens.css';
import '@/styles/fonts.css';
import '@/styles/reset.css';
import '@/styles/base.css';
import '@/styles/motion.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>FX renderer — dev</title>
    <FontPreload />
  </head>
  <body>
    <canvas id="fx" class="fx-canvas" aria-hidden="true"></canvas>
    <main class="panel">
      <Container>
        <Stack gap={5}>
          <Heading level={1} size="h2">
            FX renderer
          </Heading>
          <Text tone="muted">
            Draws a spinning triangle with the site renderer and render loop. Lose and restore the
            WebGL context to check recovery: one restore is allowed, a second loss ends in "failed".
            The loop stops while the tab is hidden, while the canvas is hidden and while the context
            is lost. Without a forced tier, slow frames step the tier down (high, medium, low, then
            static). With <code>?scene=vortex</code> it runs the vortex simulation instead, at the
            tier's particle count.
          </Text>
          <dl class="status" aria-live="polite">
            <dt>Status</dt>
            <dd data-fx="status">starting</dd>
            <dt>Quality</dt>
            <dd data-fx="quality">–</dd>
            <dt>Adaptive</dt>
            <dd data-fx="adaptive">–</dd>
            <dt>FPS (2 s avg)</dt>
            <dd data-fx="fps">–</dd>
            <dt>Tier changes</dt>
            <dd data-fx="tier-changes">–</dd>
            <dt>Size</dt>
            <dd data-fx="size">–</dd>
            <dt>Restores</dt>
            <dd data-fx="restores">0</dd>
            <dt>Loop</dt>
            <dd data-fx="loop">idle</dd>
            <dt>Paused by</dt>
            <dd data-fx="paused-by">–</dd>
            <dt>Frames</dt>
            <dd data-fx="frames">0</dd>
            <dt>Particles</dt>
            <dd data-fx="particles">–</dd>
            <dt>Sim steps</dt>
            <dd data-fx="sim-steps">–</dd>
            <dt>Sim build</dt>
            <dd data-fx="sim-build">–</dd>
            <dt>Scroll</dt>
            <dd data-fx="scroll">–</dd>
            <dt>Scroll peak</dt>
            <dd data-fx="scroll-peak">–</dd>
            <dt>Scroll max step</dt>
            <dd data-fx="scroll-max-step">–</dd>
            <dt>GL error</dt>
            <dd data-fx="gl-error">–</dd>
          </dl>
          <div class="actions">
            <button type="button" data-fx-action="lose">
              Lose context
            </button>
            <button type="button" data-fx-action="restore">
              Restore context
            </button>
            <button type="button" data-fx-action="toggle-canvas" aria-pressed="false">
              Hide canvas
            </button>
          </div>
        </Stack>
      </Container>
    </main>
    <div class="scroll-space" aria-hidden="true"></div>
  </body>
</html>

<script>
  import {
    BufferAttribute,
    BufferGeometry,
    Mesh,
    MeshBasicMaterial,
    OrthographicCamera,
    PerspectiveCamera,
    Scene,
    type Camera,
  } from 'three';

  import { parseFxOverride } from '@/fx/core/capabilities';
  import { initLoop, type RenderLoop } from '@/fx/core/loop';
  import { attachAdaptiveQuality, type QualityChange } from '@/fx/core/quality';
  import { initRenderer, type RenderQuality } from '@/fx/core/renderer';
  import { createStateController } from '@/fx/core/state';
  import { createVortexParticles, type VortexParticles } from '@/fx/vortex/particles';
  import { attachScrollReaction } from '@/fx/vortex/scroll';
  import { createVortexSimulation, type VortexSimulation } from '@/fx/vortex/simulation';

  // One turn every ~5 s, independent of the frame rate (the loop's delta is in seconds).
  const ROTATION_PER_S = 1.2;
  const GL_ERROR_SAMPLE_FRAMES = 30;
  const TRIANGLE = new Float32Array([0, 0.3, 0, -0.26, -0.15, 0, 0.26, -0.15, 0]);
  // Below the status panel on every screen shape (camera fits the shorter side to [-1, 1]).
  const TRIANGLE_Y = -0.6;

  function field(name: string): HTMLElement {
    const element = document.querySelector<HTMLElement>(`[data-fx="${name}"]`);
    if (!element) throw new Error(`Missing [data-fx="${name}"]`);
    return element;
  }

  function show(name: string, value: string | number): void {
    field(name).textContent = String(value);
  }

  /** Upper bound for `?work=`, so a typo cannot freeze the tab. */
  const MAX_WORK_MS = 50;

  const canvas = document.querySelector<HTMLCanvasElement>('#fx');
  const params = new URLSearchParams(location.search);
  const isVortex = params.get('scene') === 'vortex';
  // Read in the browser: the page is prerendered, so the query string does not exist at build time.
  if (params.get('panel') === 'off') document.body.dataset.panel = 'off';
  if (isVortex) document.body.dataset.scene = 'vortex';
  const forced = parseFxOverride(location.search).quality;
  // On the site `static` (and `?fx=off`) never creates a renderer; the vortex scene does the same.
  const vortexOff = isVortex && forced === 'static';
  const isForced = forced !== null && forced !== 'static';
  const quality: RenderQuality = isForced ? forced : 'high';
  const workParam = Number(params.get('work') ?? 0);
  const workMs = Number.isFinite(workParam) ? Math.min(Math.max(workParam, 0), MAX_WORK_MS) : 0;

  const CALIBRATION_MS = 20;
  let sink = 0;

  /** A fixed amount of arithmetic, so its wall time grows with a DevTools CPU throttle. */
  function spin(iterations: number): void {
    for (let i = 0; i < iterations; i += 1) sink = (sink + Math.sqrt(i)) % 1e6;
  }

  /** Iterations per millisecond at full speed, measured once at load (before any throttle). */
  function calibrate(): number {
    const batch = 10_000;
    let iterations = 0;
    const end = performance.now() + CALIBRATION_MS;
    while (performance.now() < end) {
      spin(batch);
      iterations += batch;
    }
    return iterations / CALIBRATION_MS;
  }

  const workIterations = workMs > 0 ? Math.round(calibrate() * workMs) : 0;

  // Dev camera for the vortex: the disk is tilted and turned like the hero mockup C
  // (docs/design/p1-ds-01: tilt 0.3, rotate −24°). The real placement is the scene owner's job.
  const VORTEX_CAMERA_Z = 6.5;
  const VORTEX_FOV = 40;
  const VORTEX_TILT_X = 0.32;
  const VORTEX_TURN_Z = -0.42;

  if (canvas && vortexOff) {
    show('status', 'static');
    show('quality', 'static');
  } else if (canvas) {
    try {
      const fx = initRenderer({ canvas, quality });
      const loop: RenderLoop = initLoop({ canvas });
      const gl = fx.three.getContext();
      // Keep the extension object: after a loss getExtension() returns null.
      const loseContext = gl.getExtension('WEBGL_lose_context');

      const scene = new Scene();
      const ortho = new OrthographicCamera(-1, 1, 1, -1, 0, 1);
      const perspective = new PerspectiveCamera(VORTEX_FOV, 1, 0.1, 50);
      perspective.position.set(0, 0, VORTEX_CAMERA_Z);
      const camera: Camera = isVortex ? perspective : ortho;

      let mesh: Mesh | null = null;
      let simulation: VortexSimulation | null = null;
      let particles: VortexParticles | null = null;
      const fxState = createStateController();

      if (isVortex) {
        const floatRenderTarget = gl.getExtension('EXT_color_buffer_float') ? 'float' : 'half';
        const buildStart = performance.now();
        simulation = createVortexSimulation({
          renderer: fx,
          loop,
          quality,
          floatRenderTarget,
          state: fxState,
        });
        particles = createVortexParticles({ simulation, state: fxState });
        particles.points.rotation.set(VORTEX_TILT_X, 0, VORTEX_TURN_Z);
        scene.add(particles.points);
        const sim = simulation;
        sim.ready.then(
          () =>
            show(
              'sim-build',
              `${(performance.now() - buildStart).toFixed(0)} ms in tasks (${floatRenderTarget})`,
            ),
          (error: unknown) => {
            show('sim-build', 'failed');
            console.error(error);
          },
        );
        // The owner advances the state tween before the simulation reads it.
        loop.subscribe(({ delta }) => fxState.update(delta), { order: -200 });
        const scrollVel = sim.inputs.uScrollVel;
        attachScrollReaction({ loop, target: scrollVel });
        // Largest change between two frames: the "no jerk" check of tests/e2e/fx-scroll.spec.ts.
        let lastScroll = 0;
        let scrollPeak = 0;
        let scrollMaxStep = 0;
        loop.subscribe(() => {
          const value = scrollVel.value;
          scrollPeak = Math.max(scrollPeak, value);
          scrollMaxStep = Math.max(scrollMaxStep, Math.abs(value - lastScroll));
          lastScroll = value;
          show('scroll', value.toFixed(3));
          show('scroll-peak', scrollPeak.toFixed(3));
          show('scroll-max-step', scrollMaxStep.toFixed(3));
        });
      } else {
        const geometry = new BufferGeometry();
        geometry.setAttribute('position', new BufferAttribute(TRIANGLE, 3));
        // Dev-only page: the accent from tokens.css (#4D7CFF) as a hex literal for three.
        mesh = new Mesh(geometry, new MeshBasicMaterial({ color: 0x4d7cff }));
        mesh.position.y = TRIANGLE_Y;
        scene.add(mesh);
      }

      // Fits the shorter side to [-1, 1], so the triangle stays inside portrait screens too.
      const fitCamera = (): void => {
        const aspect = fx.size.width / Math.max(fx.size.height, 1);
        perspective.aspect = aspect;
        perspective.updateProjectionMatrix();
        const x = Math.max(aspect, 1);
        const y = Math.max(1 / aspect, 1);
        ortho.left = -x;
        ortho.right = x;
        ortho.top = y;
        ortho.bottom = -y;
        ortho.updateProjectionMatrix();
      };

      const changes: string[] = [];
      let isStatic = false;

      const render = (): void => {
        show('status', fx.status);
        show('quality', isStatic ? 'static' : fx.quality);
        show('size', `${fx.size.width}×${fx.size.height} @${fx.size.pixelRatio}`);
        show('restores', fx.restores);
        if (simulation) show('particles', simulation.disposed ? 0 : simulation.count);
        // The last frame before a loss reads CONTEXT_LOST_WEBGL; that is expected, not a bug.
        if (fx.status !== 'ready') show('gl-error', '–');
      };

      // The loop state is read on a timer, not from the loop itself: a paused loop runs no code.
      const showLoop = (): void => {
        show('loop', loop.running ? 'running' : 'paused');
        show('paused-by', [...loop.pauseReasons].sort().join(', ') || '–');
        const fps = adaptive.governor.fps;
        show('fps', fps === null ? '–' : fps.toFixed(1));
        if (simulation) show('sim-steps', simulation.steps);
      };
      setInterval(showLoop, 100);

      let draws = 0;
      const stopDrawing = loop.subscribe(({ delta, frame }) => {
        if (workIterations > 0) spin(workIterations);
        if (mesh) mesh.rotation.z += ROTATION_PER_S * delta;
        particles?.update(fx.size.pixelRatio);
        fx.three.render(scene, camera);
        draws += 1;
        show('frames', frame);
        // getError() waits for the GPU, so it is sampled, not called every frame.
        if (draws % GL_ERROR_SAMPLE_FRAMES === 1) {
          show('gl-error', gl.getError() === gl.NO_ERROR ? 'none' : 'error');
        }
      });

      const adaptive = attachAdaptiveQuality({
        loop,
        renderer: fx,
        initial: quality,
        isMobile: matchMedia('(pointer: coarse)').matches,
        adaptive: !isForced,
        onChange: (change: QualityChange) => {
          changes.push(change.to);
          show('tier-changes', changes.join(' → '));
          // On the site the owner shows the poster here; this page just stops drawing.
          if (change.to === 'static') {
            isStatic = true;
            stopDrawing();
            simulation?.dispose();
            particles?.dispose();
          } else {
            simulation?.setQuality(change.to);
          }
          render();
        },
      });
      show('adaptive', isForced ? 'off (forced tier)' : 'on');

      fx.on('resize', () => {
        fitCamera();
        render();
      });
      fx.on('lost', () => {
        loop.pause('context');
        render();
      });
      fx.on('restored', () => {
        loop.resume('context');
        render();
      });
      fx.on('failed', () => {
        stopDrawing();
        simulation?.dispose();
        particles?.dispose();
        adaptive.dispose();
        render();
      });
      fitCamera();
      render();
      showLoop();

      document.querySelector('[data-fx-action="lose"]')?.addEventListener('click', () => {
        if (fx.status === 'ready') loseContext?.loseContext();
      });
      document.querySelector('[data-fx-action="restore"]')?.addEventListener('click', () => {
        if (fx.status === 'lost') loseContext?.restoreContext();
      });
      const toggle = document.querySelector<HTMLButtonElement>('[data-fx-action="toggle-canvas"]');
      toggle?.addEventListener('click', () => {
        const hide = !canvas.hidden;
        canvas.hidden = hide;
        toggle.setAttribute('aria-pressed', String(hide));
        toggle.textContent = hide ? 'Show canvas' : 'Hide canvas';
      });
    } catch (error) {
      show('status', 'unsupported');
      console.error(error);
    }
  }
</script>

<style>
  /* Not --z-fx: body paints its own background (base.css), which would cover a canvas at -1.
     Placing the site canvas under content is P1.FX.02's job; here the panel simply comes later. */
  .fx-canvas {
    position: fixed;
    inset: 0;
    z-index: var(--z-base);
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .panel {
    position: relative;
    padding-block: var(--space-8);
  }

  :global([data-panel='off']) .panel {
    display: none;
  }

  /* Room to scroll the vortex scene; the canvas is fixed, so only the scroll position changes. */
  .scroll-space {
    display: none;
  }

  :global([data-scene='vortex']) .scroll-space {
    display: block;
    block-size: 400vh;
  }

  .status {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--space-2) var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-small);
  }

  dt {
    color: var(--color-text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  button {
    min-block-size: 2.75rem;
    padding-inline: var(--space-5);
    color: var(--color-on-accent);
    background: var(--color-accent);
    border-radius: var(--radius-pill);
  }

  button:hover {
    background: var(--color-accent-hover);
  }
</style>

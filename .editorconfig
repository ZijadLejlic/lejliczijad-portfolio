# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Two trailing spaces are a hard line break in Markdown/MDX.
[*.{md,mdx}]
trim_trailing_whitespace = false

# Blender pipeline scripts follow PEP 8.
[*.py]
indent_size = 4

[Makefile]
indent_style = tab

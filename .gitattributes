# Normalize every text file to LF in the repo and in the working tree,
# so Windows checkouts do not produce CRLF diffs or break shell scripts.
* text=auto eol=lf

# Source and config (explicit, so detection never guesses wrong)
*.astro   text diff=html
*.svelte  text diff=html
*.html    text diff=html
*.css     text diff=css
*.ts      text
*.js      text
*.mjs     text
*.cjs     text
*.json    text
*.jsonc   text
*.md      text diff=markdown
*.mdx     text diff=markdown
*.yml     text
*.yaml    text
*.py      text diff=python
*.sh      text eol=lf
*.svg     text
*.txt     text
*.xml     text
*.glsl    text linguist-language=GLSL
*.vert    text linguist-language=GLSL
*.frag    text linguist-language=GLSL

# Lockfile: keep it out of diffs and language stats
pnpm-lock.yaml  text -diff linguist-generated=true

# Binary assets
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.avif   binary
*.ico    binary
*.heic   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.eot    binary
*.pdf    binary
*.mp4    binary
*.webm   binary
*.mov    binary
*.mp3    binary
*.wav    binary
*.glb    binary
*.ply    binary
*.usdz   binary
*.bin    binary
*.zip    binary
*.gz     binary
*.br     binary

{
  "name": "lejliczijad-portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": "12.23.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:prod": "node scripts/checks/content-guard.ts && astro build",
    "check:content": "node scripts/checks/content-guard.ts",
    "fonts": "node scripts/fonts/fetch.ts",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"**/*.{css,astro,svelte}\" --allow-empty-input --cache --cache-location node_modules/.cache/stylelint/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:e2e": "playwright test tests/e2e",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm lint:css && pnpm typecheck && pnpm test:unit",
    "prepare": "husky",
    "postinstall": "node scripts/fonts/fetch.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.9",
    "@astrojs/mdx": "8.1.6",
    "@pmndrs/detect-gpu": "6.0.32",
    "astro": "7.4.13",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/vitest-plugin": "1.8.5",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "astro-eslint-parser": "3.2.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "postcss-html": "2.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-svelte": "4.2.0",
    "stylelint": "18.1.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-recess-order": "7.10.1",
    "stylelint-config-standard": "41.1.0",
    "stylelint-order": "8.1.3",
    "svelte": "5.59.1",
    "svelte-eslint-parser": "1.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1",
    "wrangler": "4.168.0"
  }
}

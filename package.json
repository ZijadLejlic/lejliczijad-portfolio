{
  "name": "lejliczijad-portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": "12.23.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"**/*.{css,astro,svelte}\" --allow-empty-input --cache --cache-location node_modules/.cache/stylelint/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm lint:css && pnpm typecheck && pnpm test:unit"
  },
  "dependencies": {
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/vitest-plugin": "1.8.1",
    "@eslint/js": "10.0.1",
    "astro-eslint-parser": "3.2.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "postcss-html": "2.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-svelte": "4.2.0",
    "stylelint": "18.1.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-recess-order": "7.10.1",
    "stylelint-config-standard": "41.1.0",
    "stylelint-order": "8.1.3",
    "svelte": "5.59.1",
    "svelte-eslint-parser": "1.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.0"
  }
}

# Build-time public variables (tech.md §9.7). Copy to `.env` for local dev:
#   cp .env.example .env
# Every value here ends up in the client bundle, so never put a secret in this file.
# Schema and validation: `env.schema` in astro.config.ts. A missing required var fails the build.

# Required. Canonical origin, no trailing slash.
PUBLIC_SITE_URL=https://lejliczijad.com

# Required. production | preview | development
# Anything other than `production` emits noindex and disables analytics (tech.md §4).
PUBLIC_DEPLOY_ENV=development

# Optional until P1.CONT.04. Cloudflare's public test sitekey that always passes;
# production uses the real sitekey from the Turnstile dashboard.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Optional until P1.ANL.02. Public Umami Cloud website ID (not a secret, P0.ACC.07).
PUBLIC_UMAMI_WEBSITE_ID=5ffb4174-1d86-495f-97a7-7fca89f695d9

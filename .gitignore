# --- Dependencies -------------------------------------------------------------
node_modules/
.pnpm-store/

# --- Build output and generated types ----------------------------------------
dist/
.astro/
.wrangler/
.output/
.cache/
*.tsbuildinfo

# --- Test and tooling output -------------------------------------------------
# Visual baselines (*-snapshots/) are committed on purpose; only run output is ignored.
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/
.lighthouseci/
.eslintcache
.stylelintcache

# --- Secrets and local env (never commit; see AGENTS.md §11) -----------------
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key
*.p12

# --- Private intake material (P1.ENV.21) ------------------------------------
# content/intake/ is its own private repo (lejliczijad-private), cloned here.
# It holds client notes, testimonials, assets and the calculator pricing data,
# none of which may land in this public repo. Raw scans and photos stay out of
# both repos (see that repo's .gitignore).
content/intake/

# --- Licensed fonts (ITF FFL v2.0, ADR-017) ---------------------------------
# Clash Display and Satoshi may not be redistributed via public repositories;
# `pnpm install` downloads and verifies them (scripts/fonts/fetch.ts).
src/assets/fonts/ClashDisplay-*.woff2
src/assets/fonts/Satoshi-*.woff2

# --- Logs --------------------------------------------------------------------
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS ----------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
desktop.ini

# --- Editors and local agent settings ----------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~
.claude/settings.local.json
